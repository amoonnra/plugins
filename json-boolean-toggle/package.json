{
  "name": "json-boolean-toggle",
  "displayName": "JSON Boolean Toggle",
  "description": "Toggle JSON boolean values directly from clickable inlay hints.",
  "version": "0.1.2",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#071a3c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "json",
    "jsonc",
    "boolean",
    "toggle",
    "inlay hints",
    "configuration"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "JSON Boolean Toggle",
      "properties": {
        "jsonBooleanToggle.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show clickable ON/OFF inlay hints next to boolean values in JSON and JSON with Comments files."
        }
      }
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --main-fields=module,main --external:vscode --outfile=dist/extension.js --sourcemap --sources-content=false",
    "bundle:watch": "npm run bundle -- --watch",
    "dom-hack:install": "powershell -NoProfile -ExecutionPolicy Bypass -File experimental/dom-hack/install.ps1",
    "dom-hack:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File experimental/dom-hack/uninstall.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"experimental/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run bundle",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^64.5.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
