{
  "name": "json-boolean-toggle-dom",
  "displayName": "JSON Boolean Toggle DOM (Experimental)",
  "description": "Render clickable pill toggles for JSON booleans through an unsupported VS Code DOM patch.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#071a3c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "json",
    "jsonc",
    "boolean",
    "toggle",
    "dom",
    "experimental"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onCommand:jsonBooleanToggleDom.installPatch",
    "onCommand:jsonBooleanToggleDom.uninstallPatch"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "jsonBooleanToggleDom.installPatch",
        "title": "JSON Boolean Toggle DOM: Install Experimental UI"
      },
      {
        "command": "jsonBooleanToggleDom.uninstallPatch",
        "title": "JSON Boolean Toggle DOM: Restore VS Code Workbench"
      }
    ],
    "configuration": {
      "title": "JSON Boolean Toggle DOM",
      "properties": {
        "jsonBooleanToggleDom.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show ON/OFF inlay hints next to boolean values in JSON and JSON with Comments files."
        }
      }
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --main-fields=module,main --external:vscode --outfile=dist/extension.js --sourcemap --sources-content=false && esbuild src/domPatchCli.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/dom-patch-cli.js --sources-content=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"renderer/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run bundle",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^64.5.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
